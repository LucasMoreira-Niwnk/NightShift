extends SceneTree
const Layout = preload("res://scripts/scenery_layout.gd")
const TARGET := "res://scenes/cenario_editavel.tscn"
var layout := Layout.new()
var copies: Dictionary = {}
var root_scene: Node3D
var sequence := 0
func _initialize() -> void: call_deferred("run")
func run() -> void:
	if FileAccess.file_exists(TARGET) and not OS.get_cmdline_user_args().has("--replace-scenery"):
		push_error("The editable scenery already exists. Refusing to overwrite manual edits.")
		quit(1)
		return
	var game: Node3D = load("res://scenes/main.tscn").instantiate()
	root.add_child(game)
	game.set_process(false)
	game.chapter.set_process(false)
	game.world.set_process(false)
	game.player.set_physics_process(false)
	# Deferred plaques are part of the static scenery as well.
	await process_frame
	layout.build_index(game)
	root_scene = Node3D.new()
	root_scene.name = "CenarioEditavel"
	root.add_child(root_scene)
	var baseline := PackedStringArray()
	for key in layout.nodes:
		if not layout.protected.has(key): baseline.append(key)
	root_scene.set_meta("vesper_baseline",baseline)
	root_scene.set_meta("vesper_format",1)
	copy_node(game.world,root_scene,"Predio",false)
	copy_node(game.computer,root_scene,"ReferenciaTerminal",true)
	# Meshes generated by world.box have sibling collision bodies. Group them
	# so editor move/rotate/scale operations affect both geometry and collision.
	for key in layout.nodes:
		var source: Node = layout.nodes[key]
		if not source is MeshInstance3D or not source.mesh is BoxMesh or not copies.has(source): continue
		var siblings := source.get_parent().get_children()
		var i := source.get_index()+1
		if i >= siblings.size(): continue
		var body: Node = siblings[i]
		if body.get_script() != null or not body is StaticBody3D or not copies.has(body): continue
		if not body.position.is_equal_approx(source.position): continue
		copies[body].reparent(copies[source],true)
	# Hidden furniture collision proxies follow their imported visual asset.
	var art := preload("res://scripts/art.gd")
	for source in copies:
		if not source is MeshInstance3D or source.visible or not source.mesh is BoxMesh: continue
		var preview: Node3D = copies[source]
		var bounds: AABB = source.transform*source.get_aabb()
		var best: Node3D = null
		var volume := INF
		for candidate in source.get_parent().get_children():
			if not copies.has(candidate) or candidate == source: continue
			var script: Script = candidate.get_script()
			var is_asset: bool = candidate.has_meta("source_scene")
			if script == null:
				for child in candidate.get_children():
					if child.has_meta("source_scene"): is_asset = true
			elif script.resource_path == "res://scripts/lighting_fixture.gd": is_asset = true
			if not is_asset: continue
			var model_bounds: AABB = art.mesh_bounds(candidate,Transform3D.IDENTITY).grow(0.25)
			if model_bounds.encloses(bounds) and model_bounds.get_volume()<volume:
				best = copies[candidate]
				volume = model_bounds.get_volume()
		if best != null: preview.reparent(best,true)
	# Keep each ceiling fixture and its source light together in the editor.
	for fixture in game.world.lighting_fixtures:
		if copies.has(fixture) and copies.has(fixture.source) and fixture.source.get_parent() == fixture.get_parent():
			copies[fixture.source].reparent(copies[fixture],true)
	organize_rooms(game)
	# Godot 4.0 clears scene ownership when reparenting; restore authored nodes.
	for copy in copies.values(): copy.owner = root_scene
	add_editor_lighting()
	var packed := PackedScene.new()
	var result := packed.pack(root_scene)
	if result == OK: result = ResourceSaver.save(packed,TARGET)
	if result != OK:
		push_error("Scenery save failed: "+str(result))
		quit(1)
		return
	print("SCENERY_BAKED: ",copies.size()," nodes; ",FileAccess.get_file_as_bytes(TARGET).size()," bytes")
	quit()

func copy_node(source: Node, parent: Node, preferred: String = "", reference: bool = false) -> Node:
	if not source is Node3D or source in layout.excluded: return null
	var copy: Node3D
	var imported := not source.scene_file_path.is_empty()
	if imported:
		copy = imported_preview(source)
	else:
		copy = ClassDB.instantiate(source.get_class())
		for entry in source.get_property_list():
			var property: String = entry.name
			if not entry.usage & PROPERTY_USAGE_STORAGE or property in ["script","name","owner","scene_file_path"] or property.begins_with("metadata/"): continue
			if not Layout.property_exists(copy,property): continue
			var value = source.get(property)
			if value is Object and not value is Resource: continue
			copy.set(property,value)
	parent.add_child(copy)
	copy.owner = root_scene
	sequence += 1
	copy.name = preferred if not preferred.is_empty() else readable_name(source)+"_%04d" % sequence
	copy.transform = source.transform
	copy.visible = source.visible
	copies[source] = copy
	var key := ""
	for candidate in layout.nodes:
		if layout.nodes[candidate] == source:
			key = candidate
			break
	if not key.is_empty():
		copy.set_meta(Layout.ID,key)
		if layout.protected.has(key):
			reference = true
			copy.set_meta(Layout.REFERENCE,true)
			copy.set_meta("_edit_lock_",true)
	if imported:
		copy.set_meta(Layout.ATOMIC,true)
		return copy
	if reference and copy is MeshInstance3D and copy.material_override is ShaderMaterial:
		if copy.material_override.shader.resource_path == "res://shaders/crt_screen.gdshader":
			var black := StandardMaterial3D.new()
			black.albedo_color = Color(0.015,0.025,0.02)
			copy.material_override = black
	for child in source.get_children(): copy_node(child,copy,"",reference)
	return copy

func imported_preview(source: Node3D) -> Node3D:
	var hidden: Array[String] = []
	for child in source.find_children("*","Node3D",true,false):
		if not child.visible: hidden.append(str(source.get_path_to(child)))
	if hidden.is_empty(): return load(source.scene_file_path).instantiate()
	# Tiny inherited scenes preserve selected mesh variants without embedding
	# imported vertex buffers in the editable map.
	var signature := (source.scene_file_path+str(hidden)).md5_text().left(16)
	var path := "res://scenes/scenery_models/variant_"+signature+".tscn"
	DirAccess.make_dir_recursive_absolute("res://scenes/scenery_models")
	var text := "[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"PackedScene\" path="+JSON.stringify(source.scene_file_path)+" id=\"1\"]\n\n[node name=\"Model\" instance=ExtResource(\"1\")]\n"
	for child_path in hidden:
		var parent_path := child_path.get_base_dir()
		if parent_path.is_empty(): parent_path = "."
		text += "\n[node name="+JSON.stringify(child_path.get_file())+" parent="+JSON.stringify(parent_path)+"]\nvisible = false\n"
	var file := FileAccess.open(path,FileAccess.WRITE)
	file.store_string(text)
	file.close()
	return load(path).instantiate()

func readable_name(node: Node) -> String:
	var script: Script = node.get_script()
	if script != null:
		var filename := script.resource_path.get_file().get_basename()
		return {"building_exterior":"Exterior","folded_stairs":"Escadas","second_floor":"SegundoAndar","lighting_fixture":"Luminaria","door":"ReferenciaPorta","interactable":"ReferenciaInteracao"}.get(filename,filename)
	var given := str(node.name)
	return given if not given.begins_with("@") and given != "" else node.get_class()

func organize_rooms(game: Node) -> void:
	var ground: Node3D = copies[game.world]
	var groups := {}
	for source in copies:
		var preview: Node3D = copies[source]
		if preview.get_parent() != ground or source in [game.world.architecture,game.world.staircases,game.world.upper]: continue
		var point: Vector3 = preview.global_position
		var area := "Terreo_Corredor"
		if preview.has_meta(Layout.REFERENCE): area = "ReferenciasDoRoteiro_NaoEditar"
		elif point.y>3.9: area = "SegundoAndar_Objetos"
		elif point.z>4: area = "Terreo_Recepcao"
		elif point.x < -2 and point.z > -3: area = "Terreo_Seguranca"
		elif point.x < -2: area = "Terreo_Tecnica"
		elif point.x > 2: area = "Terreo_Arquivo"
		if not groups.has(area):
			var group := Node3D.new()
			group.name = area
			ground.add_child(group)
			group.owner = root_scene
			groups[area] = group
			if area.begins_with("Referencias"): group.set_meta("_edit_lock_",true)
		preview.reparent(groups[area],true)

func add_editor_lighting() -> void:
	var preview := Node3D.new()
	preview.name = "PreviewEdicao"
	preview.set_meta("vesper_editor_only",true)
	root_scene.add_child(preview)
	preview.owner = root_scene
	for index in range(2):
		var sun := DirectionalLight3D.new()
		sun.name = "LuzPrincipal" if index == 0 else "Preenchimento"
		sun.rotation = Vector3(-0.9,-0.6,0) if index == 0 else Vector3(-0.5,2.3,0)
		sun.light_energy = 0.8 if index == 0 else 0.4
		sun.shadow_enabled = false
		preview.add_child(sun)
		sun.owner = root_scene
